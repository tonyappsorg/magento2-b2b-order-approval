        <mj-text font-size="12px" font-weight="600" letter-spacing="1px" text-transform="uppercase" color="#f5a623">{{trans "Order approval · Request #%id" id=$request_id}}</mj-text>
        <mj-text font-size="24px" font-weight="600">{{trans "%buyer needs your approval" buyer=$buyer_name}}</mj-text>
        <mj-text>{{trans "Hi %name, %buyer would like to place this order for %company." name=$admin_name buyer=$buyer_name company=$company_name}}</mj-text>
        <mj-text font-weight="600">{{trans "Requested order"}}</mj-text>
        <mj-raw ta-block="b2b_order_approval_items"></mj-raw>
        <mj-button background-color="#1979c3" border-radius="3px" font-size="16px" font-weight="600" inner-padding="14px 32px" href="{{var approval_url}}">{{trans "Review the request"}}</mj-button>
        <mj-divider border-width="1px" border-color="#e5e5e5"></mj-divider>
        <mj-text font-size="12px" color="#999999">{{trans "Approving lets the buyer complete checkout; it does not place or pay for the order. If the cart changes, a new request is needed."}}</mj-text>
