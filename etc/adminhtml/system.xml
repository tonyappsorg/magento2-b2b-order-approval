<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="tonyapps" translate="label" sortOrder="500"><label>Tonyapps</label></tab>
        <section id="tonyapps_b2b_order_approval" translate="label" type="text" sortOrder="80"
                 showInDefault="1" showInWebsite="1" showInStore="0">
            <label>B2B Order Approval</label>
            <tab>tonyapps</tab>
            <resource>Tonyapps_B2bOrderApproval::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="0">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enable Order Approval</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="minimum_subtotal" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Minimum Base Subtotal Requiring Approval</label>
                    <comment>Set to 0 to require approval for every order placed by a company member. Company administrators can always place orders directly.</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                </field>
            </group>
        </section>
    </system>
</config>
